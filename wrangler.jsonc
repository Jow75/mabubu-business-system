{
  // Cloudflare Worker (API) + static app files. See docs/DEPLOY.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mabubu",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Serve /index.html as itself. The default redirects it to "/", and the
    // offline cache (service worker) refuses to install on that redirect.
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Only the one public address; no per-version preview addresses to the live database.
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mabubu",
      "database_id": "99eb0bfa-4c87-4afc-be5f-3cb0faf397ef",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
  // No staging copy (removed 26 Oct 2026 at the owner's request): every
  // change is deployed here and checked here, before go-live with test
  // records that the go-live clears (docs/DEPLOY.md).
}
